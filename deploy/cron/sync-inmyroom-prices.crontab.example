# Ежедневное обновление цен и наличия с INMYROOM.ru (shop_url или артикул IMR-*).
# Скопируйте строку на сервер под пользователем deploy и подставьте пути к venv и к backend.
#
# crontab -e
#

# Каждый день в 00:00 (локальное время сервера)
0 0 * * * cd /home/deploy/sofa-marketplace/backend && /home/deploy/sofa-marketplace/backend/.venv/bin/python manage.py sync_inmyroom_prices --sleep 1 --set-shop-url >> /home/deploy/sofa-marketplace/backend/logs/inmyroom_sync.log 2>&1
