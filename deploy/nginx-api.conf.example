# Конфигурация Nginx для API
# Скопируйте в /etc/nginx/sites-available/sofa-api
# Замените yourdomain.com на ваш домен и /home/deploy на путь к проекту

server {
    listen 80;
    server_name api.yourdomain.com;

    # Увеличиваем лимит размера загружаемых файлов до 200GB
    # Для загрузки очень больших файлов (3D модели, архивы и т.д.)
    client_max_body_size 200G;

    # Увеличиваем таймауты для загрузки очень больших файлов (200GB файлы могут загружаться часами)
    # Увеличено до 4 часов для надежной загрузки больших файлов
    proxy_connect_timeout 14400s;  # 4 часа
    proxy_send_timeout 14400s;     # 4 часа
    proxy_read_timeout 14400s;    # 4 часа
    send_timeout 14400s;          # 4 часа

    # Увеличиваем буферы для больших файлов
    client_body_buffer_size 128k;
    proxy_buffering off;  # Отключаем буферизацию для больших файлов (streaming)
    proxy_request_buffering off;  # Отключаем буферизацию запросов для больших загрузок

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Таймауты для больших файлов (200GB файлы могут загружаться часами)
        proxy_connect_timeout 14400s;  # 4 часа
        proxy_send_timeout 14400s;     # 4 часа
        proxy_read_timeout 14400s;     # 4 часа
        
        # Отключаем буферизацию для больших файлов
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /static/ {
        alias /home/deploy/sofa-marketplace/backend/staticfiles/;
        
        # CORS заголовки для статики
        add_header 'Access-Control-Allow-Origin' 'https://yourdomain.com' always;
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
    }

    location /media/ {
        alias /home/deploy/sofa-marketplace/backend/media/;
        
        # CORS заголовки для медиа файлов (включая 3D модели)
        add_header 'Access-Control-Allow-Origin' 'https://yourdomain.com' always;
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
        
        # Для больших файлов (3D модели могут быть большими)
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        
        # Кеширование для медиа файлов (30 дней)
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    
    # Отдельная локация для 3D моделей с оптимизацией
    location ~* \.(glb|gltf|usdz|fbx)$ {
        alias /home/deploy/sofa-marketplace/backend/media/;
        
        # CORS
        add_header 'Access-Control-Allow-Origin' 'https://yourdomain.com' always;
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
        
        # Оптимизация для больших файлов
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        
        # Агрессивное кеширование (90 дней)
        expires 90d;
        add_header Cache-Control "public, immutable";
        
        # gzip сжатие для GLTF (JSON-based)
        gzip on;
        gzip_types application/octet-stream model/gltf+json model/gltf-binary;
        gzip_min_length 1000;
    }
}

# Глобальные настройки gzip (добавьте в http блок /etc/nginx/nginx.conf)
# gzip on;
# gzip_vary on;
# gzip_proxied any;
# gzip_comp_level 6;
# gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml model/gltf+json;

