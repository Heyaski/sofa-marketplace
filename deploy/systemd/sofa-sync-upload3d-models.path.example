[Unit]
Description=Watch upload3d SFTP folders and import into catalog
Documentation=file:/home/deploy/sofa-marketplace/deploy/cron/README.md

[Path]
PathExists=/home/upload3d/models
PathChanged=/home/upload3d/models
PathExists=/models
PathChanged=/models
Unit=sofa-sync-upload3d-models.service

[Install]
WantedBy=multi-user.target
