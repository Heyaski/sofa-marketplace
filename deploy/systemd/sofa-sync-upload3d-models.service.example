[Unit]
Description=Sofa Marketplace — auto-import SFTP upload3d files into catalog
Documentation=file:/home/deploy/sofa-marketplace/deploy/cron/README.md
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sofa-marketplace/backend
EnvironmentFile=-/home/deploy/sofa-marketplace/backend/.env
Environment=SOFA_BACKEND_DIR=/home/deploy/sofa-marketplace/backend
Environment=SOFA_PYTHON=/home/deploy/sofa-marketplace/backend/venv/bin/python
Environment=UPLOAD3D_SYNC_DEBOUNCE_SEC=45
ExecStart=/home/deploy/sofa-marketplace/deploy/scripts/sync-upload3d-debounced.sh
Nice=10
IOSchedulingClass=best-effort
