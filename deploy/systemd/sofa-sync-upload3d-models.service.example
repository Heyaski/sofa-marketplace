[Unit]
Description=Sofa Marketplace — import upload3d SFTP files into catalog
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sofa-marketplace/backend
EnvironmentFile=-/home/deploy/sofa-marketplace/backend/.env
ExecStart=/home/deploy/sofa-marketplace/backend/venv/bin/python manage.py sync_upload3d_models
StandardOutput=journal
StandardError=journal
