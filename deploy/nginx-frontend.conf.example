# Конфигурация Nginx для фронтенда
# Скопируйте в /etc/nginx/sites-available/sofa-frontend
# Замените yourdomain.com на ваш домен

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # APK мобильного приложения (статика, без прокси через Node)
    location /downloads/ {
        alias /home/deploy/sofa-marketplace/frontend/public/downloads/;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition 'attachment; filename="vizhub-ar.apk"';
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

