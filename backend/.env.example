# Скопируйте в backend/.env и заполните значения

# --- Почта (Mail.ru SMTP) ---
# Создайте ящик на Mail.ru (или корпоративный на biz.mail.ru).
# Если включена 2FA — сгенерируйте «пароль для внешнего приложения»:
# https://help.mail.ru/mail/security/protection/external
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=noreply@yourdomain.ru
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=VizHub <noreply@yourdomain.ru>

# --- OAuth (после регистрации приложений) ---
# VK ID: https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://api.vizhub.pro/api/auth/vk/callback/

# Яндекс ID: https://oauth.yandex.ru/ → «Приложение для авторизации»
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.vizhub.pro/api/auth/yandex/callback/

# Mail.ru OAuth: https://o2.mail.ru/app/
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI=https://api.vizhub.pro/api/auth/mailru/callback/

# URL фронтенда (редирект после OAuth, ссылки в письмах)
FRONTEND_URL=https://vizhub.pro

# --- Мобильное приложение VizHub AR ---
MOBILE_APK_DOWNLOAD_URL=https://www.vizhub.pro/downloads/vizhub-ar.apk
# iOS: App Store (при публикации) или TestFlight (бета)
MOBILE_IOS_APP_STORE_URL=
MOBILE_IOS_TESTFLIGHT_URL=

# GLB → USDZ для AR в Safari на iPhone (из GLB на сайте; USDZ вручную не нужен)
# apt install blender на Ubuntu без USD — используйте backend/scripts/install_blender_usd.sh
# GLB_TO_USDZ_ENABLED=1
# BLENDER_BIN=/opt/blender-4.2.11-linux-x64/blender
GLB_TO_USDZ_ENABLED=1
