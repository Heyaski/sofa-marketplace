{
  "expo": {
    "name": "VizHub AR",
    "slug": "vizhub-ar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vizhubar",
    "userInterfaceStyle": "light",
    "android": {
      "package": "pro.vizhub.ar",
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3f77cb46-4164-4fde-a117-6c1c138eace0"
      }
    },
    "owner": "anton_tenditnik"
  }
}
